# Twinklr environment configuration reference.
#
# NOTE: no code in this repo loads a .env file automatically — copying this to
# .env and filling it in has no effect. Export these as real shell environment
# variables instead (e.g. `export OPENAI_API_KEY='your-key-here'`, or set them
# in your shell profile). This file exists only as a list of the variable
# names Twinklr reads.

# Required — LLM agent orchestration (OpenAI Responses API)
OPENAI_API_KEY=

# Optional — online lyrics lookup
GENIUS_ACCESS_TOKEN=

# Optional — audio fingerprinting
ACOUSTID_API_KEY=

# Optional — WhisperX model downloads
HF_TOKEN=
