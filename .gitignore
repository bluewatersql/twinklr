# === OS metadata ===
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# === Editors / IDEs (machine-local) ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Obsidian (vault runtime state is machine-local; no shared config is versioned) ===
.obsidian/

# === Agent-local / session state ===
# Shared agent knowledge is Git-tracked in AGENTS.md, CLAUDE.md, context/, changes/,
# memories/, prompts/. Everything below is machine-local runtime state.
.claude/
.cursor/
.cursorrules
.codex/
.chatgpt/
.memories/
.omc/
.omc-workspace
.remember/
.opencode/

# === Python ===
__pycache__/
*.py[cod]
*$py.class
.venv/

# === Test / lint / type-check caches ===
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# === Build / packaging ===
dist/
build/
*.egg-info/
# The reactivation campaign's plan & specs live in changes/twinklr-reactivation-review/build/
# (tracked); packaging build/ dirs elsewhere stay ignored
!/changes/twinklr-reactivation-review/build/
!/changes/twinklr-reactivation-review/build/**

# === Generated project data & run artifacts (never check in) ===
data/
artifacts/
.archive/
.dev/

# catalog/templates/ is tracked (P1K-T3), but its FE-computed sidecar cache is not
catalog/templates/.enrichment/

# === Local configuration (create from documented schemas; see context/engineering/conventions.md) ===
config.json
fixture_config.json
job_config.json

# === Environment / secrets ===
.env
.env.*
!.env.example

# === Logs / temp ===
*.log
logs/
tmp/
temp/
.cache/

# === Backups ===
*.bak*
