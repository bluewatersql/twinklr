        "distribution": [
          {
            "domains": [
              "pan",
              "tilt"
            ],
            "spread_cycles": 0.25
          },
          {
            "domains": [
              "dimmer"
            ],
            "spread_cycles": 0.25
          }
        ]
      }
    ],
    "metadata": {
      "description": "Gentle tilt rocking across a wall wash with gradual fade-in. Restored arrangement on explicit rig aims; physical degrees and rates are checked.",
      "recommended_sections": [
        "intro",
        "verse"
      ],
      "energy_range": [
        10,
        35
      ],
      "tags": [
        "arrangement_restoration",
