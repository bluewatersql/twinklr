{
  "template": {
    "template_id": "fan_iris",
    "version": 1,
    "name": "Fan Iris",
    "category": "medium_energy",
    "repeat": {
      "mode": "JOINER",
      "cycle_bars": 4,
      "loop_step_ids": [
        "motion"
      ],
      "remainder_policy": "HOLD_LAST_POSE"
