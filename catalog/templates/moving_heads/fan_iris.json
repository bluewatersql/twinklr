        },
        "distribution": [
          {
            "domains": [
              "pan",
              "tilt"
            ],
            "spread_cycles": 0.25,
            "wings": 2
          }
        ]
      }
    ],
    "metadata": {
      "tags": [
        "movement_restoration",
        "polyline"
      ],
      "recommended_sections": [
        "verse",
        "chorus",
        "bridge"
      ],
      "energy_range": [
        20,
        90
      ],
      "description": "Mirrored fan opening and closing from rig fan aims with inner/outer tilt bias, in an outside-in wave. Requires movement_fan_bias positions."
    }
  },
