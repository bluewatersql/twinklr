{
  "template": {
    "template_id": "zoom_wave",
    "version": 1,
    "name": "Zoom Wave",
    "category": "low_energy",
    "repeat": {
      "mode": "JOINER",
      "cycle_bars": 2.0,
      "loop_step_ids": [
        "wave"
      ],
      "remainder_policy": "HOLD_LAST_POSE"
    },
    "steps": [
      {
        "step_id": "wave",
        "target": "ALL",
        "timing": {
          "base_timing": {
            "start_offset_bars": 0.0,
            "duration_bars": 2.0
          }
        },
        "movement": {
          "shape": "sine_pan",
          "mode": "periodic",
          "start_pan_deg": 0.0,
          "start_tilt_deg": 30.0,
          "pan_extent_deg": 15.0,
          "period_beats": 4.0
        },
        "dimmer": {
          "period_beats": 4.0,
          "duty_cycle": 1.0,
          "low": 0.0,
          "high": 1.0
        },
        "shutter_state": "open",
        "reposition_fallback": "drop_accent",
        "distribution": [
          {
            "domains": [
              "pan",
              "tilt"
            ],
            "spread_cycles": 0.25
          }
        ],
        "zoom": {
          "shape": "sine",
          "start_deg": 25.0,
          "extent_deg": 10.0
        }
      }
    ],
    "metadata": {
      "tags": [
        "zoom",
        "wave",
        "continuous"
      ],
      "recommended_sections": [
        "verse",
        "bridge",
        "intro"
      ],
      "energy_range": [
        20,
        60
      ],
      "description": "Each head sways gently while its beam widens and narrows with the sway, lit throughout, in a wave across the rig."
    }
  },
  "presets": [
    {
      "preset_id": "narrow",
      "step_patches": {
        "wave": {
          "movement": {
            "pan_extent_deg": 8.0
          }
        }
      }
    },
    {
      "preset_id": "slow",
      "step_patches": {
        "wave": {
          "movement": {
            "period_beats": 8.0
          }
        }
      }
    }
  ]
}
