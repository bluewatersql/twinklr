          "duty_cycle": 1,
          "low": 0.1,
          "high": 1.0,
          "edge_dark_beats": 0.5,
          "fade": "out"
        }
      }
    ],
    "metadata": {
      "description": "Three-phase arc: sweep build, accent-snap drop (loops), groove-sway recovery. Restored arrangement on explicit rig aims; physical degrees and rates are checked.",
